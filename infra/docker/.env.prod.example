# Saldora Production Environment Variables
# Copy to .env.prod and fill in real values.

# Domain
DOMAIN=saldora.rs

# PostgreSQL
POSTGRES_USER=saldora
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=saldora

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# Storage (Cloudflare R2)
STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=YOUR_R2_ACCESS_KEY
STORAGE_SECRET_KEY=YOUR_R2_SECRET_KEY
STORAGE_BUCKET=saldora-documents

# OCR (Modal)
DOTS_OCR_SERVER_URL=https://cepa995--saldora-dots-ocr-dotsocrserver-web.modal.run/v1
DOTS_OCR_MODEL_NAME=rednote-hilab/dots.ocr
DOTS_OCR_API_KEY=YOUR_MODAL_API_KEY

# Anthropic (LLM extraction)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Email (Resend)
RESEND_API_KEY=YOUR_RESEND_KEY

# Error tracking (Sentry)
SENTRY_DSN=
