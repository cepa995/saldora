# Saldora Production Caddy Configuration
# Handles HTTPS termination and reverse proxying.
# When behind Cloudflare proxy, Caddy uses Cloudflare's origin cert.

# Main site — Next.js frontend
{$DOMAIN:saldora.rs} {
	reverse_proxy web:3000
}

# API subdomain — FastAPI backend
api.{$DOMAIN:saldora.rs} {
	reverse_proxy api:8000
}
