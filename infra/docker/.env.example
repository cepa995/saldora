# Saldora Environment Variables
# Copy this file to .env and fill in the values

# Application
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://saldora:saldora_dev@localhost:5433/saldora

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage (MinIO for local, S3/R2 for production)
STORAGE_ENDPOINT=http://localhost:9010
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=saldora-documents

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256

# APR Integration (Serbian Business Registry)
APR_API_URL=https://api.apr.gov.rs
APR_API_TIMEOUT=10

# Stripe (Payment processing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Sentry (Error tracking)
SENTRY_DSN=

# ML Processing
OCR_PRIMARY_ENGINE=dots
OCR_FALLBACK_ENGINE=easyocr
OCR_USE_GPU=true
OCR_CONFIDENCE_THRESHOLD=0.80
