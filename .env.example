# Saldora Environment Variables
# Copy this file to .env and fill in the values

# Application
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://saldora:saldora_dev@localhost:5433/saldora

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage (MinIO for local, S3/R2 for production)
STORAGE_ENDPOINT=http://localhost:9010
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=saldora-documents

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256

# APR Integration (Serbian Business Registry)
APR_API_URL=https://api.apr.gov.rs
APR_API_TIMEOUT=10

# Paddle Billing (Merchant of Record — Stripe unavailable in Serbia)
PADDLE_API_KEY=pdl_sdbx_...
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_SIDE_TOKEN=test_...

# Paddle Price IDs (sandbox products)
PADDLE_PRICE_ID_STARTER_MONTHLY=pri_...
PADDLE_PRICE_ID_STARTER_ANNUAL=pri_...
PADDLE_PRICE_ID_PRO_MONTHLY=pri_...
PADDLE_PRICE_ID_PRO_ANNUAL=pri_...
PADDLE_PRICE_ID_AGENCY_MONTHLY=pri_...
PADDLE_PRICE_ID_AGENCY_ANNUAL=pri_...

# Sentry (Error tracking)
SENTRY_DSN=

# ML Processing
OCR_PRIMARY_ENGINE=dots
OCR_FALLBACK_ENGINE=easyocr
OCR_USE_GPU=true
OCR_CONFIDENCE_THRESHOLD=0.80
